{
  "openapi": "3.1.0",
  "info": {
    "title": "Notq Pronunciation Analysis API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/analyze-pronunciation": {
      "post": {
        "summary": "Analyze Pronunciation Endpoint",
        "operationId": "analyze_pronunciation_endpoint_api_v1_analyze_pronunciation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyze-audio": {
      "post": {
        "summary": "Analyze Audio Endpoint",
        "operationId": "analyze_audio_endpoint_api_v1_analyze_audio_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_audio_endpoint_api_v1_analyze_audio_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session-report": {
      "post": {
        "summary": "Session Report Endpoint",
        "operationId": "session_report_endpoint_api_v1_session_report_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array",
                "title": "Results"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Session Report Endpoint Api V1 Session Report Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "expected_word": {
            "type": "string",
            "minLength": 1,
            "title": "Expected Word",
            "examples": [
              "أرنب"
            ]
          },
          "predicted_word": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Word",
            "examples": [
              "أنب"
            ]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence",
            "examples": [
              0.87
            ]
          }
        },
        "type": "object",
        "required": [
          "expected_word"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "expected_word": {
            "type": "string",
            "title": "Expected Word"
          },
          "predicted_word": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted Word"
          },
          "is_correct": {
            "type": "boolean",
            "title": "Is Correct"
          },
          "needs_retry": {
            "type": "boolean",
            "title": "Needs Retry"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            },
            "type": "array",
            "title": "Errors"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "expected_word",
          "predicted_word",
          "is_correct",
          "needs_retry",
          "errors"
        ],
        "title": "AnalyzeResponse"
      },
      "Body_analyze_audio_endpoint_api_v1_analyze_audio_post": {
        "properties": {
          "expected_word": {
            "type": "string",
            "minLength": 1,
            "title": "Expected Word"
          },
          "audio": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Audio"
          }
        },
        "type": "object",
        "required": [
          "expected_word",
          "audio"
        ],
        "title": "Body_analyze_audio_endpoint_api_v1_analyze_audio_post"
      },
      "ErrorItem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "expected": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected"
          },
          "predicted": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Predicted"
          }
        },
        "type": "object",
        "required": [
          "type",
          "expected",
          "predicted"
        ],
        "title": "ErrorItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}